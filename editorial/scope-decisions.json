  "policy": {
    "action": "exclude-from-default-search",
    "preserveHistory": true,
    "requiresHumanSourceReviewBeforeReentry": true,
    "note": "These decisions change catalogue scope, not the truth of provider claims. Records remain available as typed resources and retain Git history."
