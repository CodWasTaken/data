  "rules": [
    {
      "id": "duplicate-bundle-components",
      "reasonCode": "component-offer",
      "rationale": "Individual AWS Activate and GitHub Student Developer Pack components duplicate a larger bundle and overwhelm default opportunity discovery.",
      "resourceType": "benefit",
      "groupTargetsByPrefix": {
        "aws-activate-": "aws-activate-cloud-credits",
        "github-student-pack-": "github-student-developer-pack"
      },
      "match": {
        "idPrefixes": ["aws-activate-", "github-student-pack-"],
        "excludeIds": ["aws-activate-cloud-credits"]
      },
      "expectedMatches": 151
    },
