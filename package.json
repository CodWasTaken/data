{
  "name": "@perkcommons/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:sources": "tsx scripts/audit-sources.ts",
    "coverage": "tsx scripts/coverage.ts",
    "generate": "tsx scripts/generate-schema-artifacts.ts",
    "generate:check": "tsx scripts/generate-schema-artifacts.ts --check",
    "reports": "tsx scripts/report-catalog-health.ts",
    "research:availability": "tsx scripts/research-availability.ts && tsx scripts/render-availability-report.ts",
    "research:availability:report": "tsx scripts/render-availability-report.ts",
    "availability:apply": "tsx scripts/apply-availability-decisions.ts",
    "availability:check": "tsx scripts/apply-availability-decisions.ts --check",
    "migrate:v2": "tsx scripts/migrate-v1-to-v2.ts",
    "scope:apply": "tsx scripts/apply-scope-decisions.ts",
    "scope:check": "tsx scripts/apply-scope-decisions.ts --check",
    "status:apply": "tsx scripts/correct-generated-statuses.ts",
    "status:check": "tsx scripts/correct-generated-statuses.ts --check",
    "validate": "tsx scripts/validate.ts",
    "check": "npm run generate:check && npm run scope:check && npm run status:check && npm run availability:check && npm run structured:check && npm run validate",
    "test": "npm run check && tsx --test tests/*.test.ts",
    "structured:apply": "tsx scripts/apply-structured-field-overrides.ts",
    "structured:check": "tsx scripts/apply-structured-field-overrides.ts --check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
