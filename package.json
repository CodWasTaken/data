{
  "name": "@perkcommons/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:sources": "tsx scripts/audit-sources.ts",
    "coverage": "tsx scripts/coverage.ts",
    "generate": "tsx scripts/generate-schema-artifacts.ts",
    "generate:check": "tsx scripts/generate-schema-artifacts.ts --check",
    "reports": "tsx scripts/report-catalog-health.ts",
    "migrate:v2": "tsx scripts/migrate-v1-to-v2.ts",
    "validate": "tsx scripts/validate.ts",
    "check": "npm run generate:check && npm run validate",
    "test": "npm run check && tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
